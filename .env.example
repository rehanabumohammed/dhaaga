# Copy this file to .env in the repository root. The scripts read it themselves,
# so there is nothing to `source` - that instruction was Unix-only and did not
# work in PowerShell. .env is git-ignored and must stay that way.
#
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
#
# A variable already set in your shell always wins over this file, which is how
# a single command can be pointed somewhere else without editing anything.
# Local development database (PostgreSQL 16, matching Supabase's major version).
DHAAGA_DB_URL=postgres://postgres@127.0.0.1:5433/dhaaga_dev
DHAAGA_TEST_DB_URL=postgres://postgres@127.0.0.1:5433/dhaaga_test
DHAAGA_ENV=dev

# Supabase project (see docs/supabase.md).
# The publishable key is not a secret - it ships inside the app. Its safety
# depends on row-level security, not on being hidden.
SUPABASE_URL=https://rnkazgaixjgdzzaebqyv.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_Ji1DEeVnWm95kdVvBQOQ3w_9o8_CGYT

# Never place a service_role key or the database password in this file or any
# committed file. The Supabase CLI prompts for the database password locally.
