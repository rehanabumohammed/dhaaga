# ---------------------------------------------------------------------------
# Dhaaga backend (added WP-1)
# ---------------------------------------------------------------------------
.env
*.log
# Generated by scripts/export_supabase.py; db/migrations is the source of truth.
# (A trailing comment on a pattern line is part of the pattern, not a comment,
#  which is why this was silently doing nothing until WP-6.)
/supabase/migrations/

/supabase/.temp/
# ---------------------------------------------------------------------------
# Dhaaga backup artifacts (WP-10)
# ---------------------------------------------------------------------------
/dhaaga_backup*.sql
/backup.sql
/dump.sql
/*.dump
/backups/

# Flutter generated localization artifacts
/lib/l10n/app_localizations*.dart
